{
    "name": "rss/vlog",
    "description": "Log viewer for Laravel, CodeIgniter and PHP applications.",
    "keywords": [
        "log-viewer",
        "logs",
        "laravel",
        "codeigniter",
        "monolog",
        "debugging"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "rizwan25"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^1.23 || ^2.36 || ^3.8 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "laravel/framework": "Vlog registers itself automatically in Laravel 8 and later."
    },
    "autoload": {
        "psr-4": {
            "Rss\\Vlog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rss\\Vlog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": [
            "phpstan analyse --memory-limit=1G",
            "phpstan analyse -c phpstan.adapters.neon --memory-limit=1G"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rss\\Vlog\\Adapters\\Laravel\\VlogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
